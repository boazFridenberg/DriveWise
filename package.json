{
  "name": "drivewise",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DriveWise — Full-Stack TCO Calculator (Graduation Project)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "start": "npm run start -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
